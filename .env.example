# Environment Variables
# Copy this file to .env.local and fill in your Firebase and deployment settings

# Firebase Client Configuration (public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side only, keep secure)
FIREBASE_ADMIN_SDK_KEY=your_admin_sdk_private_key_json_or_path

# Email Configuration (transactional mail provider)
EMAIL_PROVIDER=sendgrid  # or other provider
EMAIL_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Application Settings
NODE_ENV=development
APP_URL=http://localhost:3000

# Environment Variables
# Copy this file to .env.local and fill in your Firebase and deployment settings

# Firebase Client Configuration (public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (server-side only, keep secure)
FIREBASE_ADMIN_SDK_KEY=your_admin_sdk_private_key_json_or_path

# Email Configuration (transactional mail provider)
# Supported providers: gmail (SMTP), sendgrid, resend
EMAIL_PROVIDER=gmail
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# SendGrid: your SG API key
EMAIL_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=your_email@gmail.com
# SMTP overrides (required for Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

# Vercel Blob Storage (server-side only)
# Generate a token at https://vercel.com/docs/storage/vercel-blob/using-blob-sdk#generate-a-token
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# Cron / Scheduler
# Set a secret to protect cron endpoints from unauthorized access
CRON_SECRET=your_cron_secret_here

# Application Settings
NODE_ENV=development
APP_URL=http://localhost:3000

// Cloud Storage Security Rules
// Controls access to task attachments

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Task attachments: task/{taskId}/attachments/{attachmentId}
    match /tasks/{taskId}/attachments/{attachmentId} {
      // Allow read if user has access to the task
      allow read: if request.auth != null && canAccessTask(request.auth.uid, taskId);

      // Allow write if user has collaborator+ role and can access task
      allow write: if request.auth != null &&
                     canAccessTask(request.auth.uid, taskId) &&
                     hasRole(request.auth.uid, ['collaborator', 'coordinator', 'administrator']);
    }

    // Helper functions
    function hasRole(userId, roles) {
      let userRole = get(/databases/firestore/documents/users/$(userId)).data.roleId;
      return userRole in (roles is list ? roles : [roles]);
    }

    function canAccessTask(userId, taskId) {
      let task = get(/databases/firestore/documents/tasks/$(taskId)).data;
      let userRole = get(/databases/firestore/documents/users/$(userId)).data.roleId;

      if (userRole == 'administrator') {
        return true;
      }

      return task.createdBy == userId || task.responsibleUserId == userId || userId in task.participantIds;
    }
  }
}
